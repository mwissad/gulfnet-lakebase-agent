# Local development — copy to .env and fill in your workspace values
DATABRICKS_CONFIG_PROFILE=<your-profile>

# Lakebase Autoscaling (memory + long-running agent server)
LAKEBASE_AUTOSCALING_PROJECT=gulfnet-agent
LAKEBASE_AUTOSCALING_BRANCH=production
LAKEBASE_AUTOSCALING_ENDPOINT=projects/gulfnet-agent/branches/production/endpoints/primary
LAKEBASE_AGENT_MEMORY_SCHEMA=gulfnet_agent_memory

# GulfNet OLTP / search / orchestration database
GULFNET_DATABASE=gulfnet

# Models — pick an endpoint with reliable multi-step tool calling
LLM_ENDPOINT_NAME=databricks-claude-sonnet-4-5
DATABRICKS_EMBEDDING_ENDPOINT=databricks-gte-large-en

# Long-term memories injected into the first turn of each conversation
MEMORY_RECALL_LIMIT=10

# Optional: set when Lakebase Search extensions are enabled
# USE_LAKEBASE_SEARCH=0

TASK_TIMEOUT_SECONDS=3600
POLL_INTERVAL_SECONDS=1
ENABLE_QUEUE_WORKER=1
QUEUE_POLL_SECONDS=3

CHAT_APP_PORT=3000
CHAT_PROXY_TIMEOUT_SECONDS=300
MLFLOW_TRACKING_URI=databricks
MLFLOW_REGISTRY_URI=databricks-uc
# Create an experiment in your workspace and paste the ID here
MLFLOW_EXPERIMENT_ID=
